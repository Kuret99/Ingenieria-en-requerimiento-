<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Si quiero que el  instalador (o el usuario) puede editar "Data Source" con la instancia elegida.
		     Por defecto usa la instancia local SQLEXPRESS de la misma maquina. -->
		<add name="Ing.Software"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Ing.Software;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>